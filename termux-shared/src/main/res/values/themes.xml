<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     The light themes are only for day mode and must not be defined in values-night/themes.xml.
     Material 3 light baseline synchronized with Catppuccin Latte tokens.
    -->

    <!-- BaseActivity Light DarkActionBar theme (Material 3 Light). -->
    <style name="Theme.BaseActivity.Light.DarkActionBar" parent="Theme.Material3.Light">
        <!-- Primary brand & accent colors. -->
        <item name="colorPrimary">@color/catppuccin_latte_accent</item>
        <item name="colorPrimaryVariant">@color/catppuccin_latte_accent</item>
        <item name="colorOnPrimary">@color/catppuccin_latte_on_accent</item>
        <item name="colorPrimaryContainer">@color/catppuccin_latte_surface_container_high</item>
        <item name="colorOnPrimaryContainer">@color/catppuccin_latte_on_surface</item>

        <!-- Secondary brand colors. -->
        <item name="colorSecondary">@color/catppuccin_latte_accent</item>
        <item name="colorSecondaryVariant">@color/catppuccin_latte_accent</item>
        <item name="colorOnSecondary">@color/catppuccin_latte_on_accent</item>
        <item name="colorSecondaryContainer">@color/catppuccin_latte_surface_container_high</item>
        <item name="colorOnSecondaryContainer">@color/catppuccin_latte_on_surface</item>

        <!-- Material 3 surface, outline, and error tokens. -->
        <item name="colorSurface">@color/catppuccin_latte_surface</item>
        <item name="colorOnSurface">@color/catppuccin_latte_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/catppuccin_latte_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/catppuccin_latte_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/catppuccin_latte_surface_container_high</item>
        <item name="colorOutline">@color/catppuccin_latte_outline</item>
        <item name="colorError">@color/catppuccin_latte_error</item>
        <item name="colorOnError">@color/catppuccin_latte_on_error</item>

        <!-- Window & system bars. -->
        <item name="android:colorBackground">@color/catppuccin_latte_surface_container</item>
        <item name="android:windowBackground">@color/catppuccin_latte_surface_container</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/catppuccin_latte_surface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/catppuccin_latte_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorPrimaryDark" tools:targetApi="l">@color/catppuccin_latte_surface</item>

        <!-- Text colors. -->
        <item name="android:textColorPrimary">@color/catppuccin_latte_on_surface</item>
        <item name="android:textColorSecondary">@color/catppuccin_latte_on_surface_variant</item>
        <item name="android:textColorLink">@color/catppuccin_latte_accent</item>

        <!-- Dialog Themes. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BaseDialog.DayNight</item>
    </style>

    <!-- BaseActivity Light NoActionBar theme. -->
    <style name="Theme.BaseActivity.Light.NoActionBar" parent="Theme.BaseActivity.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- BaseActivity DayNight DarkActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar"/>
    <!-- BaseActivity DayNight NoActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar"/>

    <!-- BaseActivity extended classes Day NoActionBar themes. -->
    <style name="Theme.MediaViewActivity.Light" parent="Theme.BaseActivity.Light.NoActionBar"/>
    <style name="Theme.MarkdownViewActivity.Light" parent="Theme.MediaViewActivity.Light"/>

    <!-- BaseActivity extended classes DayNight NoActionBar themes. -->
    <style name="Theme.MediaViewActivity.DayNight" parent="Theme.BaseActivity.DayNight.NoActionBar"/>
    <style name="Theme.MarkdownViewActivity.DayNight" parent="Theme.MediaViewActivity.DayNight"/>

    <!-- BaseDialog Light theme (Material 3 AlertDialog overlay). -->
    <style name="ThemeOverlay.BaseDialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/catppuccin_latte_accent</item>
        <item name="colorPrimaryVariant">@color/catppuccin_latte_accent</item>
        <item name="colorOnPrimary">@color/catppuccin_latte_on_accent</item>
        <item name="colorSecondary">@color/catppuccin_latte_accent</item>
        <item name="colorSecondaryVariant">@color/catppuccin_latte_accent</item>
        <item name="colorOnSecondary">@color/catppuccin_latte_on_accent</item>
        <item name="colorSurface">@color/catppuccin_latte_surface_container</item>
        <item name="colorOnSurface">@color/catppuccin_latte_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/catppuccin_latte_on_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/catppuccin_latte_surface_container_high</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/BaseDialog.Title.Panel</item>
        <item name="materialAlertDialogBodyTextStyle">@style/BaseDialog.Message.Text.Light</item>
    </style>

    <!-- BaseDialog DayNight theme. -->
    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.BaseDialog.Light"/>

    <!-- BaseDialog extended classes DayNight themes. -->
    <style name="ThemeOverlay.MessageDialog.DayNight" parent="ThemeOverlay.BaseDialog.DayNight"/>

</resources>
