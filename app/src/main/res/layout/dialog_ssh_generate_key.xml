<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/ssh_keygen_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ssh_keygen_dialog_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ssh_keygen_name_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ssh_keygen_name_label"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ssh_keygen_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/ssh_keygen_name_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ssh_keygen_passphrase_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ssh_keygen_passphrase_label"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ssh_keygen_passphrase_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/ssh_keygen_passphrase_hint"
        android:importantForAutofill="no"
        android:inputType="text|textPassword"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ssh_keygen_comment_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ssh_keygen_comment_label"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/ssh_keygen_comment_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/ssh_keygen_comment_hint"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textSize="14sp" />

</LinearLayout>
